+    syncedRef.current = signature;
+    if (days.size === 0) return;
+    setCursor((c) => {
+      if (countInMonth(days, c.y, c.m) > 0) return c;
+      const earliest = [...events].sort((a, b) => a.date.localeCompare(b.date))[0];
+      return earliest ? monthOf(earliest.date) : c;
