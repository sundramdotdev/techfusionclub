+export function useTiltGlow<T extends HTMLElement = HTMLDivElement>(max = 6) {
+  const ref = useRef<T | null>(null);
+
+  useEffect(() => {
+    const el = ref.current;
+    if (!el) return;
+    if (
+      typeof window === "undefined" ||
+      !window.matchMedia("(hover: hover) and (pointer: fine)").matches ||
+      !canAnimate()
+    ) {
+      return;
+    }
